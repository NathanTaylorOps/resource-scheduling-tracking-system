# Copy this file to .env before running any Prisma or Next.js command.

# Used by Prisma's own tooling (generate, db push, studio) and by
# `npm run db:build-template` to build prisma/template.db — not read by the
# running app itself, which gives each visitor their own database instead
# (see lib/db.ts). No changes needed for local use.
DATABASE_URL="file:./dev.db"

# National Weather Service API — no key required, but NWS asks for a
# descriptive User-Agent identifying the app and a contact method.
# See lib/weather/nws.ts.
NWS_USER_AGENT="resource-scheduling-tracking-system (you@example.com)"

# Optional. Where each visitor's private database file is written —
# defaults to the OS temp directory if unset. See lib/db.ts.
# SESSIONS_DIR="/tmp/rsts-sessions"
