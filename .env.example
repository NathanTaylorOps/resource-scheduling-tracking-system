# Copy this file to .env before running any Prisma or Next.js command.
DATABASE_URL="file:./dev.db"

# National Weather Service API — no key required, but NWS asks for a
# descriptive User-Agent identifying the app and a contact method.
# See lib/weather/nws.ts.
NWS_USER_AGENT="coastwood-fieldops (you@example.com)"
