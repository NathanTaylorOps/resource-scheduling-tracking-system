// Resource Scheduling & Tracking System — built for the fictional Coastwood
// Builders scenario (see the project README's Scope section).
// Data model. See the project README for the design rationale behind the
// compliance and maintenance tables in particular — they follow aviation
// maintenance-records practice (multi-counter, non-cumulative tolerance
// windows, hard limits) rather than the single-counter model used by most
// construction equipment-tracking tools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Jobs and crew
// ---------------------------------------------------------------------------

// Status/category-style fields below are plain Strings, not Prisma `enum`s.
// SQLite has no native enum column type, so Prisma's SQLite connector
// doesn't support the `enum` keyword in this schema at all — this isn't a
// stylistic choice, it's a hard connector limitation. The allowed values for
// each field are defined once, as a const-object-plus-union-type pair, in
// lib/enums.ts, which gives the rest of the app the same value/type
// ergonomics a real enum would without the database dependency.

model Job {
  id             String    @id @default(cuid())
  name           String
  address        String
  latitude       Float
  longitude      Float
  status         String    @default("PLANNING")
  startDate      DateTime
  targetEndDate  DateTime

  // Simplified weather-sensitivity tagging for this first pass — the design
  // doc describes tagging individual tasks (a pour, a roofing day, a crane
  // lift) with their own thresholds. Tagging the job as a whole is the
  // honest scope for v1; per-task tagging is a documented roadmap item.
  weatherSensitivity String @default("CONDITIONAL")

  assignments    Assignment[]
  scanEvents     ScanEvent[]
  weatherCache   WeatherCache[]
  roleRequirements      JobRoleRequirement[]
  equipmentReservations EquipmentReservation[]
  permits        Permit[]
  dailyLogs      DailyLog[]
  safetyMeetings SafetyMeeting[]
  lienWaivers    LienWaiver[]
  safetyIncidents SafetyIncident[]
  hazardAnalyses JobHazardAnalysis[]
  payrollEntries CertifiedPayrollEntry[]

  // Which regional office/business unit this job belongs to — nullable
  // because a single-office company (like the fictional Coastwood Builders
  // this demo is seeded around) has no real use for it, but a portfolio
  // spanning several offices does. See app/portfolio/page.tsx, the rollup
  // view this field exists for — company-wide "which region is trending
  // worse" is exactly the visibility a single flat job list can't give a
  // COO or regional Project Executive.
  division       String?

  // Gates whether CertifiedPayrollEntry rows apply to this job — a job
  // touching public money or otherwise contractually bound to Davis-Bacon-
  // style prevailing wage reporting needs weekly certified payroll on
  // file; a private residential job never does. A plain boolean rather
  // than inferring it from job type, since the real determinant is the
  // contract, not the building.
  certifiedPayrollRequired Boolean @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([division])
}

model Worker {
  id             String         @id @default(cuid())
  name           String
  trade          String
  employmentType String         @default("DIRECT_EMPLOYEE")
  hireDate       DateTime
  phone          String?
  email          String?

  // Set only for SUBCONTRACTOR-type workers — the person who actually shows
  // up on site, linked to the business whose insurance and license are what
  // actually gate their eligibility to work (see Subcontractor below). A
  // direct employee has no subcontractor; their compliance is entirely
  // personal, via WorkerCertification.
  subcontractorId String?
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])

  assignments    Assignment[]
  certifications WorkerCertification[]
  scanEvents     ScanEvent[]
  dailyLogsSubmitted      DailyLog[]
  safetyMeetingsConducted SafetyMeeting[]
  safetyMeetingAttendance SafetyMeetingAttendee[]
  screenings              WorkerScreening[]
  payrollEntries          CertifiedPayrollEntry[]
  incidentsReported       SafetyIncident[] @relation("IncidentReportedBy")
  incidentsInvolved       SafetyIncident[] @relation("IncidentInvolvedWorker")
  auditEntries            AuditLogEntry[]
  hazardAnalysesPrepared  JobHazardAnalysis[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subcontractorId])
}

// A subcontractor firm's insurance and trade license, tracked at the entity
// level rather than as another row on whichever of its workers happens to be
// on site — a real dispatch decision is gated by whether the BUSINESS is
// currently insured and licensed, not by a training card belonging to the
// individual standing in front of you. Structurally distinct from
// WorkerCertification for exactly that reason: one is a person-level
// training record, this is a firm-level eligibility-to-work record. See
// lib/domain/subcontractors.ts.
model Subcontractor {
  id                      String    @id @default(cuid())
  businessName            String
  trade                   String
  licenseNumber           String?
  licenseClass            String?
  licenseIssuingAuthority String?
  licenseExpiryDate       DateTime?
  notes                   String?

  workers                 Worker[]
  coiRecords              SubcontractorCOI[]
  lienWaivers             LienWaiver[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// One row per coverage type on a subcontractor's certificate of insurance —
// a real COI bundles several (general liability, workers' comp, commercial
// auto, umbrella), each with its own carrier, policy number, and expiry, the
// same one-row-per-item pattern EquipmentCompliance already uses for
// calibration vs. inspection vs. warranty rather than one flattened record.
model SubcontractorCOI {
  id                String        @id @default(cuid())
  subcontractorId   String
  coverageType      String
  carrier           String
  policyNumber      String
  effectiveDate     DateTime
  expiryDate        DateTime
  coverageLimit     Float?
  additionalInsured Boolean       @default(false)

  subcontractor     Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @default(now())

  @@index([subcontractorId])
}

model Assignment {
  id         String   @id @default(cuid())
  workerId   String
  jobId      String
  roleOnJob  String
  start      DateTime
  end        DateTime

  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([workerId])
  @@index([jobId])
  // Guards against an exact double-submit (a double-click, a retried
  // fetch) creating two identical rows — not against an overlapping-but-
  // different assignment, which stays intentionally allowed (see this
  // route's own comment in app/api/jobs/[id]/assignments/route.ts: a real
  // double-booking is meant to surface as a visible conflict, not be
  // write-time blocked).
  @@unique([workerId, jobId, roleOnJob, start, end])
}

// renewalPattern names which of four real-world renewal shapes this
// certification follows (see lib/domain/certifications.ts for the status
// math each one drives) — a single expiryDate field can't honestly represent
// a card that never formally expires the same way it represents a hard
// annual refresher:
//   HARD_EXPIRY       — a real wall (HAZWOPER's annual refresher, NCCCO's
//                        5-year cycle). expiryDate is the actual expiry.
//   INFORMAL_RECENCY  — never formally expires (OSHA 10/30 cards); expiryDate
//                        holds the informal recommended-refresh-by date
//                        instead, and crossing it reads as "aging," not
//                        "expired" — a real gap, but not a hard stop.
//   GRACE_PERIOD      — a fixed cycle with a filing grace window (EPA RRP's
//                        5 years / 90-day filing rule): a renewal filed on
//                        time keeps the certification valid past expiryDate
//                        while the decision is pending. renewalFiledDate
//                        records that filing.
//   LICENSE_CYCLE     — a state trade-license clock (e.g. a 2-year CSLB
//                        cycle), which behaves like HARD_EXPIRY for status
//                        purposes but is named separately since it's a
//                        different real-world renewal event.
model WorkerCertification {
  id               String    @id @default(cuid())
  workerId         String
  certType         String
  issuingBody      String
  issueDate        DateTime
  expiryDate       DateTime
  renewalPattern   String    @default("HARD_EXPIRY")
  renewalFiledDate DateTime?
  documentUrl      String?

  worker           Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workerId])
}

// A job's staffing plan, independent of who's actually assigned. Lets
// readiness distinguish "nobody's cert has lapsed" from "this job needs a
// licensed electrician and none is assigned at all" — the gap the rest of
// the compliance tracking can't see because it only ever looks at workers
// already on the job. roleOrTrade is matched against Assignment.roleOnJob
// by exact string, the same way a real staffing plan names a role rather
// than a fuzzy trade category — see findUnfilledRoles in lib/domain/scheduling.ts.
//
// requiredCertTypes is the source canAssignWorker (lib/domain/certifications.ts)
// gates against when someone's assigned to this role: a comma-separated list
// of certType values, matched the same exact-string way roleOrTrade itself
// is, and optional — most roles don't require a listed certification at all.
// It lives on the requirement rather than on Assignment because it's a
// property of the role ("an Electrician needs an Electrical License"), not
// of any one person filling it, so it only needs to be entered once per role
// rather than re-typed for every worker assigned against it.
model JobRoleRequirement {
  id                String  @id @default(cuid())
  jobId             String
  roleOrTrade       String
  requiredCount     Int     @default(1)
  requiredCertTypes String?

  job               Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // One requirement row per role per job. Without this, the requirements
  // route had nothing stopping two rows from the same job naming the same
  // roleOrTrade, and the assignments route reads a role's required certs via
  // findFirst — a second, later row (with different or absent
  // requiredCertTypes) would silently shadow the first, undermining the
  // exact hard-stop this table exists to drive. See the requirements
  // route's own check, which rejects a duplicate before this constraint
  // would ever need to.
  @@unique([jobId, roleOrTrade])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Equipment: identity, location, compliance, and maintenance
// ---------------------------------------------------------------------------

model Equipment {
  id             String          @id @default(cuid())
  name           String
  category       String
  qrCode         String          @unique
  status         String          @default("ACTIVE")
  acquisitionDate DateTime
  inServiceDate  DateTime

  // Current custody/location, updated by scan events.
  currentJobId    String?
  currentWorkerId String?
  locationNote    String? // e.g. "Yard — Bay 3" when in storage rather than on a job

  lifeCounters   EquipmentLifeCounter[]
  compliance     EquipmentCompliance[]
  maintenancePlans MaintenancePlan[]
  workOrders     WorkOrder[]
  scanEvents     ScanEvent[]
  reservations   EquipmentReservation[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // currentJobId is read on every job-detail render (`where: { currentJobId
  // }`, app/jobs/[id]/page.tsx) — the one relation this central to the UI
  // that was missing the index pattern applied everywhere else in this
  // schema. status is read almost as often (the equipment list's own
  // status column, plus every "down for service" readiness check).
  @@index([currentJobId])
  @@index([currentWorkerId])
  @@index([status])
}

// An asset can be tracked on more than one counter at once — a compressor
// on both calendar age and run-hours, for instance. Each counter is its own
// row so compliance and maintenance schedules can reference whichever one
// actually governs them.
model EquipmentLifeCounter {
  id            String      @id @default(cuid())
  equipmentId   String
  counterType   String
  currentValue  Float
  updatedAt     DateTime    @updatedAt

  equipment     Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, counterType])
}

// Calibration, inspection, and warranty tracking. The interval/tolerance/
// hardLimit/dueValue fields implement the non-cumulative tolerance-window
// pattern in lib/domain/compliance.ts.
model EquipmentCompliance {
  id                String          @id @default(cuid())
  equipmentId       String
  complianceType    String
  counterType       String
  intervalValue     Float
  toleranceValue    Float
  hardLimit         Boolean         @default(false)
  dueValue          Float
  lastCompletedAt   DateTime?
  lastCompletedValue Float?
  documentUrl       String?

  equipment         Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([equipmentId])
  // One row per (asset, compliance type, counter) — without this, nothing
  // stops a second CALIBRATION/RUN_HOURS row from being added for the same
  // asset, and readiness (lib/readiness-service.ts) sums every matching row
  // instead of reading one authoritative record, silently double-counting
  // an item that should only ever be evaluated once.
  @@unique([equipmentId, complianceType, counterType])
}

// Preventive-maintenance plans. parentPlanId enables the nested-hierarchy
// suppression logic in lib/domain/maintenance.ts — a 30-day plan nested
// under a 90-day plan is satisfied when the 90-day plan is completed.
model MaintenancePlan {
  id             String            @id @default(cuid())
  equipmentId    String
  parentPlanId   String?
  description    String
  counterType    String
  intervalValue  Float
  toleranceValue Float
  hardLimit      Boolean           @default(false)
  dueValue       Float

  equipment      Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  parentPlan     MaintenancePlan?  @relation("PlanHierarchy", fields: [parentPlanId], references: [id])
  childPlans     MaintenancePlan[] @relation("PlanHierarchy")
  workOrders     WorkOrder[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([equipmentId])
  @@index([parentPlanId])
}

model WorkOrder {
  id                  String           @id @default(cuid())
  equipmentId         String
  maintenancePlanId   String?
  source              String
  status              String           @default("OPEN")
  description         String
  completedAtValue    Float?
  completedAt         DateTime?
  createdFromScanEventId String?

  equipment           Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  // Deleting a plan that a completed work order still points back to must
  // not throw an FK-constraint error — the completed work order is a real
  // historical record and should survive the plan being removed, just with
  // that reference cleared, the same way every other optional relation in
  // this file is explicit about its onDelete behavior rather than leaving
  // it to Prisma/SQLite's restrict-by-default.
  maintenancePlan      MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)

  createdAt           DateTime         @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([equipmentId])
}

// Append-only QR scan / custody audit trail. Never updated in place — the
// current location fields on Equipment are a projection of the latest scan,
// but the full history stays here for chain-of-custody review.
model ScanEvent {
  id             String     @id @default(cuid())
  equipmentId    String
  scannedByWorkerId String?
  jobId          String?
  action         String
  timestamp      DateTime   @default(now())
  latitude       Float?
  longitude      Float?
  conditionNote  String?

  equipment      Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  scannedBy      Worker?    @relation(fields: [scannedByWorkerId], references: [id])
  job            Job?       @relation(fields: [jobId], references: [id])
  photos         ScanPhoto[]

  @@index([equipmentId])
}

model ScanPhoto {
  id          String    @id @default(cuid())
  scanEventId String
  url         String
  caption     String?

  scanEvent   ScanEvent @relation(fields: [scanEventId], references: [id], onDelete: Cascade)
}

// A forward booking of an asset to a job over a date range — distinct from
// Equipment.currentJobId, which is custody (where it physically is right
// now, set by scan events). A reservation is a plan; custody is a fact.
// Checked the same way crew double-booking is checked (see findOverlaps in
// lib/domain/scheduling.ts): two reservations for the same asset over an
// overlapping window are a conflict, via the parallel findEquipmentConflicts
// in lib/domain/equipment.ts.
model EquipmentReservation {
  id          String    @id @default(cuid())
  equipmentId String
  jobId       String
  start       DateTime
  end         DateTime

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([equipmentId])
  @@index([jobId])
  // Same exact-duplicate guard as Assignment above, for the same reason —
  // an overlapping-but-different reservation stays intentionally allowed.
  @@unique([equipmentId, jobId, start, end])
}

// ---------------------------------------------------------------------------
// Weather
// ---------------------------------------------------------------------------

// One row per job per layer. The "forecast" layer holds the real 7-10 day
// NWS forecast; the "outlook" layer holds the climatological/seasonal
// framing beyond that window. Keeping them as separate rows (and separate
// UI treatments) is what keeps the second layer honest — see
// lib/weather/outlook.ts.
model WeatherCache {
  id         String      @id @default(cuid())
  jobId      String
  layer      String
  dataJson   String
  fetchedAt  DateTime    @default(now())
  staleAfter DateTime

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, layer])
}

// ---------------------------------------------------------------------------
// Permits, inspections, and field records
// ---------------------------------------------------------------------------

// A permit is the legal gate on whether work can proceed at all — more
// fundamental than crew or equipment readiness, since a failed inspection
// stops a job regardless of who's on site or what's on the lot. Feeds its
// own readiness component (see permitsStatusFrom in lib/domain/readiness.ts)
// rather than folding into "compliance," which is about people and assets —
// a permit is about the structure, a different kind of thing.
model Permit {
  id               String       @id @default(cuid())
  jobId            String
  permitType       String
  permitNumber     String?
  issuingAuthority String
  status           String       @default("APPLIED")
  appliedDate      DateTime
  issuedDate       DateTime?
  expiryDate       DateTime?

  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspections      Inspection[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([jobId])
}

// One row per required inspection on a permit's sequence (footing, framing,
// rough-ins, final...). Kept deliberately simple for this first pass, the
// same way MaintenancePlan is: status is updated in place as the inspector's
// visit outcome changes, rather than a full re-inspection history. That's
// the same category of simplification as the equipment-usage-logging gap in
// the README — a real next step once there's a need for a full visit-by-
// visit record rather than current status.
model Inspection {
  id             String    @id @default(cuid())
  permitId       String
  inspectionType String
  sequence       Int
  status         String    @default("NOT_SCHEDULED")
  scheduledDate  DateTime?
  completedDate  DateTime?
  inspectorNotes String?

  // The correction-and-reschedule detail a failed inspection actually needs
  // in practice (a jurisdiction's own process — corrections required, who
  // fixes them, how re-inspection gets scheduled — see Portland's published
  // process). Deliberately still one row per inspection type, not a full
  // visit-by-visit history: these fields carry what's being done about a
  // failure without promoting Inspection into a full audit-trail model,
  // the same scope call the rest of this table already makes.
  correctionNotes           String?
  correctionResponsible     String?
  reinspectionChannel       String?
  reinspectionScheduledDate DateTime?

  permit         Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([permitId])
  // One inspection per step in a permit's sequence (footing, foundation,
  // framing, ... final) — without this, nothing stops two rows from
  // claiming the same sequence number, which would silently break the
  // ordered footing-through-final progression the README describes and
  // that any UI walking `sequence` in order depends on.
  @@unique([permitId, sequence])
}

// One entry per job per day — actual weather, crew on site, work performed,
// delays. Standard GC documentation (the kind that matters in a dispute or a
// warranty claim, not just a nice-to-have), and the natural place actual
// conditions get recorded alongside the forecast/outlook WeatherPanel shows.
// Informational only — it doesn't feed readiness, the same way scan history
// documents what happened without itself gating anything.
model DailyLog {
  id             String   @id @default(cuid())
  jobId          String
  logDate        DateTime
  weatherSummary String?
  crewCount      Int
  workPerformed  String
  delaysNotes    String?
  submittedBy    String?

  job              Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedByWorker Worker? @relation(fields: [submittedBy], references: [id])

  createdAt      DateTime @default(now())

  @@unique([jobId, logDate])
  @@index([jobId])
}

// A toolbox talk / safety briefing held on a job — topic, who ran it, who
// was there. Documentation of safety culture, not a compliance gate on its
// own (a missed toolbox talk doesn't block a job the way a failed inspection
// does), so like DailyLog it's informational and doesn't feed readiness.
model SafetyMeeting {
  id          String                  @id @default(cuid())
  jobId       String
  meetingDate DateTime
  topic       String
  conductedBy String

  job               Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conductedByWorker Worker                  @relation(fields: [conductedBy], references: [id])
  attendees         SafetyMeetingAttendee[]

  createdAt   DateTime                @default(now())

  @@index([jobId])
}

model SafetyMeetingAttendee {
  id              String        @id @default(cuid())
  safetyMeetingId String
  workerId        String

  safetyMeeting   SafetyMeeting @relation(fields: [safetyMeetingId], references: [id], onDelete: Cascade)
  worker          Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([safetyMeetingId, workerId])
}

// ---------------------------------------------------------------------------
// Enterprise-scale additions — see the README's "Scaling to enterprise"
// section for the reasoning behind each of these. They're real, usable
// features built on this app's existing per-visitor demo architecture, not
// a claim that this is now a certified-payroll or lien-tracking system of
// record.
// ---------------------------------------------------------------------------

// A conditional/unconditional, progress/final lien waiver exchanged with a
// subcontractor against a specific pay period — the single biggest gap two
// independent enterprise-scale reviews of this app converged on
// unprompted. At real GC scale (dozens of subs, tens of millions per job),
// tracking which waiver is outstanding for which pay period is a constant,
// high-stakes administrative burden: a missing waiver blocks the GC's own
// pay application to the owner. One row per sub per pay period per waiver
// type — a sub can owe more than one type in the same period (e.g. a
// conditional waiver at submission, replaced by an unconditional waiver
// once that payment actually clears), so this is deliberately not a
// single status field on the pay period itself.
model LienWaiver {
  id                String   @id @default(cuid())
  jobId             String
  subcontractorId   String
  payPeriodStart    DateTime
  payPeriodEnd      DateTime
  waiverType        String
  amount            Float?
  status            String   @default("PENDING")
  receivedDate      DateTime?
  notes             String?

  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  subcontractor     Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([jobId])
  @@index([subcontractorId])
}

// A near miss, injury, property-damage, or environmental incident — the
// leading-indicator safety record a toolbox talk (SafetyMeeting above)
// deliberately isn't: a toolbox talk proves a briefing happened, this
// records what actually went wrong (or almost did). NEAR_MISS is its own
// first-class type rather than a low-severity INJURY specifically so it
// doesn't get buried in exactly the trend report meant to surface it —
// near-miss rate is the metric a mature safety program actually watches.
// This is explicitly NOT an OSHA 300-series recordkeeping system (Forms
// 300/300A/301) — that's its own regulated system with its own
// recordability rules and retention requirements, and a partial,
// non-compliant version of it would be worse than not building one, same
// call the README already makes about toolbox talks vs. OSHA logs.
model SafetyIncident {
  id                String   @id @default(cuid())
  jobId             String
  incidentType      String
  severity          String
  occurredAt        DateTime
  description       String
  correctionAction  String?
  status            String   @default("OPEN")

  reportedByWorkerId String?
  involvedWorkerId   String?

  job                Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reportedByWorker   Worker? @relation("IncidentReportedBy", fields: [reportedByWorkerId], references: [id])
  involvedWorker     Worker? @relation("IncidentInvolvedWorker", fields: [involvedWorkerId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([jobId])
}

// A job hazard analysis / job safety analysis for one task on one job —
// the hazards identified and the controls put in place before the task
// starts, not after something goes wrong (that's SafetyIncident above).
// Deliberately a simple text record rather than a structured
// hazard-by-hazard checklist: a real JHA program has its own
// task-specific templates (a pour JHA looks nothing like a crane-lift
// JHA), and building one generic structured form here would either be too
// rigid for real use or too shallow to actually replace a real JHA
// program — the honest v1 is a record that a JHA was done and what it
// says, the same scope call SafetyMeeting already makes for toolbox talks.
model JobHazardAnalysis {
  id                String   @id @default(cuid())
  jobId             String
  taskDescription   String
  hazardsIdentified String
  controlMeasures   String
  preparedByWorkerId String?
  reviewDate        DateTime

  job               Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  preparedByWorker  Worker? @relation(fields: [preparedByWorkerId], references: [id])

  createdAt         DateTime @default(now())

  @@index([jobId])
}

// A drug test or background check result for a worker — distinct from
// WorkerCertification (a trade credential with a renewal cycle) and from
// SubcontractorCOI (firm-level insurance): this is a point-in-time
// screening result with no renewal math of its own. At the scale of a
// large sub workforce, many owners contractually require this on file
// before someone can badge onto a job site, and it currently had nowhere
// to live — it isn't a certification and it isn't insurance.
model WorkerScreening {
  id              String    @id @default(cuid())
  workerId        String
  screeningType   String
  result          String
  administeredDate DateTime
  expiryDate      DateTime?
  notes           String?

  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@index([workerId])
}

// One worker's classification, hours, and pay rate for one week on a job
// that requires certified payroll (Job.certifiedPayrollRequired) — the
// weekly WH-347-style record a labor compliance office actually audits on
// a prevailing-wage job. Deliberately not a full payroll system: no tax
// withholding, no net pay, no direct deposit — those live in the real
// ERP/payroll system (Viewpoint, Sage 300 CRE, CMiC) this app would need
// to integrate with at real scale, not duplicate. This is the
// classification-and-hours record that has to exist for the compliance
// report, nothing past it.
model CertifiedPayrollEntry {
  id             String   @id @default(cuid())
  jobId          String
  workerId       String
  weekEnding     DateTime
  classification String
  hoursWorked    Float
  hourlyRate     Float?
  fringeRate     Float?
  status         String   @default("DRAFT")

  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker         Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([jobId, workerId, weekEnding])
  @@index([jobId])
  @@index([workerId])
}

// An append-only record of who changed what, and when — the sharpest gap
// an engineering-scale review of this app found: every other model here
// carries only createdAt/updatedAt, which get silently overwritten on
// every edit. For a GC facing warranty claims and litigation years after a
// job closes, "who marked this permit ISSUED, and when" is exactly the
// kind of question that shows up in a deposition, and today most of this
// app's mutations can't answer it. Deliberately NOT a full field-by-field
// diff engine — that's real complexity for real production value, and
// this demo's no-auth design means "actor" is self-reported (see
// actorLabel) rather than cryptographically attributable anyway. What this
// gives instead: a durable, human-readable trail — who (as best this
// app can know, given it has no real login), what changed, and when —
// for the handful of high-stakes mutations actually wired to call
// recordAudit (see lib/audit.ts): permit status changes, inspection
// outcomes, lien waiver status, and safety incident status. Never edited
// or deleted once written, the same append-only principle ScanEvent
// already uses for equipment chain-of-custody.
model AuditLogEntry {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  summary      String

  actorWorkerId String?
  // The free-text fallback when no worker is selected as the acting
  // "viewing as" identity (see lib/role.ts) — still recorded rather than
  // left blank, since "an unattributed change happened" is itself a fact
  // worth keeping, not one to silently drop.
  actorLabel    String

  actorWorker   Worker?  @relation(fields: [actorWorkerId], references: [id])

  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
