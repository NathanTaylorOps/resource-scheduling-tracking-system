// Coastwood Builders — Field Operations Platform
// Data model. See /docs or the project README for the design rationale
// behind the compliance and maintenance tables in particular — they follow
// aviation maintenance-records practice (multi-counter, non-cumulative
// tolerance windows, hard limits) rather than the single-counter model used
// by most construction equipment-tracking tools.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Jobs and crew
// ---------------------------------------------------------------------------

// Status/category-style fields below are plain Strings, not Prisma `enum`s.
// SQLite has no native enum column type, so Prisma's SQLite connector
// doesn't support the `enum` keyword in this schema at all — this isn't a
// stylistic choice, it's a hard connector limitation. The allowed values for
// each field are defined once, as a const-object-plus-union-type pair, in
// lib/enums.ts, which gives the rest of the app the same value/type
// ergonomics a real enum would without the database dependency.

model Job {
  id             String    @id @default(cuid())
  name           String
  address        String
  latitude       Float
  longitude      Float
  status         String    @default("PLANNING")
  startDate      DateTime
  targetEndDate  DateTime

  // Simplified weather-sensitivity tagging for this first pass — the design
  // doc describes tagging individual tasks (a pour, a roofing day, a crane
  // lift) with their own thresholds. Tagging the job as a whole is the
  // honest scope for v1; per-task tagging is a documented roadmap item.
  weatherSensitivity String @default("CONDITIONAL")

  assignments    Assignment[]
  scanEvents     ScanEvent[]
  weatherCache   WeatherCache[]
  roleRequirements      JobRoleRequirement[]
  equipmentReservations EquipmentReservation[]
  permits        Permit[]
  dailyLogs      DailyLog[]
  safetyMeetings SafetyMeeting[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Worker {
  id             String         @id @default(cuid())
  name           String
  trade          String
  employmentType String         @default("DIRECT_EMPLOYEE")
  hireDate       DateTime
  phone          String?
  email          String?

  assignments    Assignment[]
  certifications WorkerCertification[]
  scanEvents     ScanEvent[]
  dailyLogsSubmitted      DailyLog[]
  safetyMeetingsConducted SafetyMeeting[]
  safetyMeetingAttendance SafetyMeetingAttendee[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Assignment {
  id         String   @id @default(cuid())
  workerId   String
  jobId      String
  roleOnJob  String
  start      DateTime
  end        DateTime

  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([workerId])
  @@index([jobId])
}

model WorkerCertification {
  id          String   @id @default(cuid())
  workerId    String
  certType    String
  issuingBody String
  issueDate   DateTime
  expiryDate  DateTime
  documentUrl String?

  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workerId])
}

// A job's staffing plan, independent of who's actually assigned. Lets
// readiness distinguish "nobody's cert has lapsed" from "this job needs a
// licensed electrician and none is assigned at all" — the gap the rest of
// the compliance tracking can't see because it only ever looks at workers
// already on the job. roleOrTrade is matched against Assignment.roleOnJob
// by exact string, the same way a real staffing plan names a role rather
// than a fuzzy trade category — see findUnfilledRoles in lib/domain/scheduling.ts.
model JobRoleRequirement {
  id            String @id @default(cuid())
  jobId         String
  roleOrTrade   String
  requiredCount Int    @default(1)

  job           Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Equipment: identity, location, compliance, and maintenance
// ---------------------------------------------------------------------------

model Equipment {
  id             String          @id @default(cuid())
  name           String
  category       String
  qrCode         String          @unique
  status         String          @default("ACTIVE")
  acquisitionDate DateTime
  inServiceDate  DateTime

  // Current custody/location, updated by scan events.
  currentJobId    String?
  currentWorkerId String?
  locationNote    String? // e.g. "Yard — Bay 3" when in storage rather than on a job

  lifeCounters   EquipmentLifeCounter[]
  compliance     EquipmentCompliance[]
  maintenancePlans MaintenancePlan[]
  workOrders     WorkOrder[]
  scanEvents     ScanEvent[]
  reservations   EquipmentReservation[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// An asset can be tracked on more than one counter at once — a compressor
// on both calendar age and run-hours, for instance. Each counter is its own
// row so compliance and maintenance schedules can reference whichever one
// actually governs them.
model EquipmentLifeCounter {
  id            String      @id @default(cuid())
  equipmentId   String
  counterType   String
  currentValue  Float
  updatedAt     DateTime    @updatedAt

  equipment     Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, counterType])
}

// Calibration, inspection, and warranty tracking. The interval/tolerance/
// hardLimit/dueValue fields implement the non-cumulative tolerance-window
// pattern in lib/domain/compliance.ts.
model EquipmentCompliance {
  id                String          @id @default(cuid())
  equipmentId       String
  complianceType    String
  counterType       String
  intervalValue     Float
  toleranceValue    Float
  hardLimit         Boolean         @default(false)
  dueValue          Float
  lastCompletedAt   DateTime?
  lastCompletedValue Float?
  documentUrl       String?

  equipment         Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([equipmentId])
}

// Preventive-maintenance plans. parentPlanId enables the nested-hierarchy
// suppression logic in lib/domain/maintenance.ts — a 30-day plan nested
// under a 90-day plan is satisfied when the 90-day plan is completed.
model MaintenancePlan {
  id             String            @id @default(cuid())
  equipmentId    String
  parentPlanId   String?
  description    String
  counterType    String
  intervalValue  Float
  toleranceValue Float
  hardLimit      Boolean           @default(false)
  dueValue       Float

  equipment      Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  parentPlan     MaintenancePlan?  @relation("PlanHierarchy", fields: [parentPlanId], references: [id])
  childPlans     MaintenancePlan[] @relation("PlanHierarchy")
  workOrders     WorkOrder[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([equipmentId])
  @@index([parentPlanId])
}

model WorkOrder {
  id                  String           @id @default(cuid())
  equipmentId         String
  maintenancePlanId   String?
  source              String
  status              String           @default("OPEN")
  description         String
  completedAtValue    Float?
  completedAt         DateTime?
  createdFromScanEventId String?

  equipment           Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenancePlan      MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])

  createdAt           DateTime         @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([equipmentId])
}

// Append-only QR scan / custody audit trail. Never updated in place — the
// current location fields on Equipment are a projection of the latest scan,
// but the full history stays here for chain-of-custody review.
model ScanEvent {
  id             String     @id @default(cuid())
  equipmentId    String
  scannedByWorkerId String?
  jobId          String?
  action         String
  timestamp      DateTime   @default(now())
  latitude       Float?
  longitude      Float?
  conditionNote  String?

  equipment      Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  scannedBy      Worker?    @relation(fields: [scannedByWorkerId], references: [id])
  job            Job?       @relation(fields: [jobId], references: [id])
  photos         ScanPhoto[]

  @@index([equipmentId])
}

model ScanPhoto {
  id          String    @id @default(cuid())
  scanEventId String
  url         String
  caption     String?

  scanEvent   ScanEvent @relation(fields: [scanEventId], references: [id], onDelete: Cascade)
}

// A forward booking of an asset to a job over a date range — distinct from
// Equipment.currentJobId, which is custody (where it physically is right
// now, set by scan events). A reservation is a plan; custody is a fact.
// Checked the same way crew double-booking is checked (see findOverlaps in
// lib/domain/scheduling.ts): two reservations for the same asset over an
// overlapping window are a conflict, via the parallel findEquipmentConflicts
// in lib/domain/equipment.ts.
model EquipmentReservation {
  id          String    @id @default(cuid())
  equipmentId String
  jobId       String
  start       DateTime
  end         DateTime

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([equipmentId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Weather
// ---------------------------------------------------------------------------

// One row per job per layer. The "forecast" layer holds the real 7-10 day
// NWS forecast; the "outlook" layer holds the climatological/seasonal
// framing beyond that window. Keeping them as separate rows (and separate
// UI treatments) is what keeps the second layer honest — see
// lib/weather/outlook.ts.
model WeatherCache {
  id         String      @id @default(cuid())
  jobId      String
  layer      String
  dataJson   String
  fetchedAt  DateTime    @default(now())
  staleAfter DateTime

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, layer])
}

// ---------------------------------------------------------------------------
// Permits, inspections, and field records
// ---------------------------------------------------------------------------

// A permit is the legal gate on whether work can proceed at all — more
// fundamental than crew or equipment readiness, since a failed inspection
// stops a job regardless of who's on site or what's on the lot. Feeds its
// own readiness component (see permitsStatusFrom in lib/domain/readiness.ts)
// rather than folding into "compliance," which is about people and assets —
// a permit is about the structure, a different kind of thing.
model Permit {
  id               String       @id @default(cuid())
  jobId            String
  permitType       String
  permitNumber     String?
  issuingAuthority String
  status           String       @default("APPLIED")
  appliedDate      DateTime
  issuedDate       DateTime?
  expiryDate       DateTime?

  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspections      Inspection[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([jobId])
}

// One row per required inspection on a permit's sequence (footing, framing,
// rough-ins, final...). Kept deliberately simple for this first pass, the
// same way MaintenancePlan is: status is updated in place as the inspector's
// visit outcome changes, rather than a full re-inspection history. That's
// the same category of simplification as the equipment-usage-logging gap in
// the README — a real next step once there's a need for a full visit-by-
// visit record rather than current status.
model Inspection {
  id             String    @id @default(cuid())
  permitId       String
  inspectionType String
  sequence       Int
  status         String    @default("NOT_SCHEDULED")
  scheduledDate  DateTime?
  completedDate  DateTime?
  inspectorNotes String?

  permit         Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([permitId])
}

// One entry per job per day — actual weather, crew on site, work performed,
// delays. Standard GC documentation (the kind that matters in a dispute or a
// warranty claim, not just a nice-to-have), and the natural place actual
// conditions get recorded alongside the forecast/outlook WeatherPanel shows.
// Informational only — it doesn't feed readiness, the same way scan history
// documents what happened without itself gating anything.
model DailyLog {
  id             String   @id @default(cuid())
  jobId          String
  logDate        DateTime
  weatherSummary String?
  crewCount      Int
  workPerformed  String
  delaysNotes    String?
  submittedBy    String?

  job              Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedByWorker Worker? @relation(fields: [submittedBy], references: [id])

  createdAt      DateTime @default(now())

  @@unique([jobId, logDate])
  @@index([jobId])
}

// A toolbox talk / safety briefing held on a job — topic, who ran it, who
// was there. Documentation of safety culture, not a compliance gate on its
// own (a missed toolbox talk doesn't block a job the way a failed inspection
// does), so like DailyLog it's informational and doesn't feed readiness.
model SafetyMeeting {
  id          String                  @id @default(cuid())
  jobId       String
  meetingDate DateTime
  topic       String
  conductedBy String

  job               Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conductedByWorker Worker                  @relation(fields: [conductedBy], references: [id])
  attendees         SafetyMeetingAttendee[]

  createdAt   DateTime                @default(now())

  @@index([jobId])
}

model SafetyMeetingAttendee {
  id              String        @id @default(cuid())
  safetyMeetingId String
  workerId        String

  safetyMeeting   SafetyMeeting @relation(fields: [safetyMeetingId], references: [id], onDelete: Cascade)
  worker          Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([safetyMeetingId, workerId])
}
